---
/**
 * 首屏。三层：CSS 天空 / DOM 方块与竖排字 / three.js 磁带 + Canvas 流线。
 *
 * 方块、符号、流线全在脚本里生成，因为它们要按视口算「只对角接触」与
 * 「越靠下越密」；写死在 markup 里等于换一个屏就散架。
 */
import Brand from '../Brand.astro';
---

<section class="hero" data-hero aria-label="Artmatic">
  <div class="hero-sky" aria-hidden="true">
    <span class="hero-blob" style="left:-6%;top:62%;width:46%;height:44%;background:radial-gradient(circle,#7a51f0,transparent 66%)"></span>
    <span class="hero-blob" style="left:58%;top:52%;width:52%;height:48%;background:radial-gradient(circle,#a98cf5,transparent 68%)"></span>
    <span class="hero-blob" style="left:22%;top:8%;width:34%;height:26%;background:radial-gradient(circle,#cbb9f8,transparent 70%)"></span>
  </div>

  <div class="hero-field" data-hero-field aria-hidden="true">
    <span class="hero-word" style="left:10.5%;top:25%;font-size:clamp(22px,2.6vw,38px)">Keyframes</span>
    <span class="hero-word" style="left:14%;top:37%;font-size:clamp(13px,1.4vw,20px);letter-spacing:.22em">Agent First</span>
    <span class="hero-word" style="right:8%;top:30%;font-size:clamp(17px,2vw,30px)" data-flip>Determinism</span>
    <span class="hero-word" style="right:4%;top:64%;font-size:clamp(14px,1.6vw,24px)" data-flip>Agents</span>
    <span class="hero-word" style="left:3.5%;top:67%;font-size:clamp(18px,2.1vw,32px)" data-flip>Creation</span>
  </div>

  <div class="hero-glyphs" data-hero-glyphs aria-hidden="true"></div>

  <canvas class="hero-cassette" data-hero-cassette aria-hidden="true"></canvas>
  <canvas class="hero-lines" data-hero-lines aria-hidden="true"></canvas>

  <div class="hero-hud hero-hud--l" aria-hidden="true"></div>
  <div class="hero-hud hero-hud--r" aria-hidden="true"></div>
  <span class="hero-plus" style="left:10px;top:12px" aria-hidden="true">+</span>
  <span class="hero-plus" style="right:10px;top:12px" aria-hidden="true">+</span>
  <span class="hero-plus" style="left:10px;bottom:10px" aria-hidden="true">+</span>
  <span class="hero-plus" style="right:10px;bottom:10px" aria-hidden="true">+</span>

  <span class="hero-tag hero-tag--l" aria-hidden="true">
    <svg viewBox="0 0 429 80" xmlns="http://www.w3.org/2000/svg">
      <g transform="translate(-121 -1194)">
        <path
          d="M517.661 1256.18 534.186 1256.18 534.186 1274 517.661 1274ZM533.475 1237.46 550 1237.46 550 1255.28 533.475 1255.28ZM501.561 1237.46 518.086 1237.46 518.086 1255.28 501.561 1255.28ZM121 1204.76 293.566 1204.76 293.566 1270.17 121 1270.17ZM314.723 1194 487.289 1194 487.289 1256.18 502.272 1256.18 502.272 1274 485.747 1274 485.747 1259.41 317.31 1259.41 317.31 1270.17 300.786 1270.17 300.786 1204.76 314.723 1204.76Z"
          fill="currentColor"
          fill-rule="evenodd"></path>
      </g>
    </svg>
  </span>
  <span class="hero-tag hero-tag--r" aria-hidden="true">
    <svg viewBox="0 0 429 80" xmlns="http://www.w3.org/2000/svg">
      <g transform="translate(-121 -1194)">
        <path
          d="M517.661 1256.18 534.186 1256.18 534.186 1274 517.661 1274ZM533.475 1237.46 550 1237.46 550 1255.28 533.475 1255.28ZM501.561 1237.46 518.086 1237.46 518.086 1255.28 501.561 1255.28ZM121 1204.76 293.566 1204.76 293.566 1270.17 121 1270.17ZM314.723 1194 487.289 1194 487.289 1256.18 502.272 1256.18 502.272 1274 485.747 1274 485.747 1259.41 317.31 1259.41 317.31 1270.17 300.786 1270.17 300.786 1204.76 314.723 1204.76Z"
          fill="currentColor"
          fill-rule="evenodd"></path>
      </g>
    </svg>
  </span>

  <div class="hero-install" aria-label="安装命令">
    <i>&gt;</i> npm i -g artmatic
  </div>

  <div class="hero-mark">
    <Brand variant="fonttype" height="clamp(40px, 4.7vw, 68px)" />
    <p class="hero-slogan">
      <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M0 0h10L5 10Z" fill="currentColor"></path></svg>
      许愿式PV一键成真
      <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M0 0h10L5 10Z" fill="currentColor"></path></svg>
    </p>
  </div>
</section>

<script>
  import { buildField } from '../../scripts/hero-field';
  import { initCassette } from '../../scripts/hero-three';
  import { initLines } from '../../scripts/hero-lines';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const field = document.querySelector<HTMLElement>('[data-hero-field]');
  const glyphs = document.querySelector<HTMLElement>('[data-hero-glyphs]');
  const cassette = document.querySelector<HTMLCanvasElement>('[data-hero-cassette]');
  const lines = document.querySelector<HTMLCanvasElement>('[data-hero-lines]');

  if (hero && field && glyphs) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    buildField(field, glyphs, { animate: !reduced });

    let origins: [number, number][] = [];
    if (lines) initLines(lines, hero, () => origins, { animate: !reduced });

    if (cassette) {
      initCassette(cassette, hero, {
        onOrigins: (next) => {
          origins = next;
        },
        animate: !reduced,
      });
    }
  }
</script>
