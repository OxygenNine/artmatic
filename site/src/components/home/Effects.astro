---
/**
 * 特效墙。缩略图是真图（gen-thumbs 从主工程复制），堆叠角度逐张累加 ——
 * 观感是「一叠被推歪的样张」，不是随机撒图。
 */
import Tri from '../site/Tri.astro';
import stats from '../../data/stats.json';

const mods = import.meta.glob<{ src: string }>('../../assets/thumbs/*.webp', {
  eager: true,
  import: 'default',
});
const files = Object.fromEntries(
  Object.entries(mods).map(([key, value]) => [key, typeof value === 'string' ? value : value.src]),
);

const fx = Object.keys(files)
  .filter((k) => k.includes('/fx-'))
  .sort()
  .map((k) => files[k]);
const gen = Object.keys(files)
  .filter((k) => k.includes('/gen-'))
  .sort()
  .map((k) => files[k]);

/* 交替取图：一堆纯特效样张会偏色，掺进生成器才像整座库 */
const cards: string[] = [];
for (let i = 0; i < Math.max(fx.length, gen.length); i++) {
  const pair = [fx[i], gen[i]].filter(Boolean) as string[];
  cards.push(...pair);
}
/*
 * 卡扇：绕中心一圈，每张的 rotateY 就等于它在圆上的角度。
 * 于是左右两端是正面（宽），上下正中是侧面（细成一条），秩序来自这条规则本身。
 * 上弧多压 16° 的 rotateX，让它像顶盖而不是镜像复制。
 */
const stack = cards.slice(0, 24).map((src, i) => {
  const deg = i * 15;
  const a = (deg * Math.PI) / 180;
  return {
    src,
    deg,
    x: `${(Math.cos(a) * 36).toFixed(2)}vw`,
    y: `${(Math.sin(a) * 30).toFixed(2)}vh`,
    rx: `${(Math.sin(a) * 10 - 4).toFixed(1)}deg`,
    z: i,
  };
});

const FX_NAMES = [
  ['切片错位', 34],
  ['数据弯折', 19],
  ['通道错位', 26],
  ['辉光', 16],
  ['流线等高', 30],
  ['RGB 爆发', 18],
  ['基础调色', 15],
  ['像素排序', 28],
  ['扫描线', 17],
  ['半调网屏', 22],
  ['熔融', 30],
  ['万花筒', 16],
  ['回声拖尾', 24],
  ['热成像', 18],
  ['液体光', 32],
  ['暗角', 14],
  ['漩涡', 26],
  ['ASCII 滤镜', 15],
  ['VHS 磁带', 28],
  ['碎片位移', 18],
  ['柔化故障', 22],
  ['抖动', 15],
] as const;

const GEN_NAMES = [
  ['黑洞', 36],
  ['流体', 20],
  ['反应扩散', 28],
  ['生命游戏', 17],
  ['Lenia', 30],
  ['阿波罗尼奥斯球堆', 15],
  ['李雅普诺夫分形', 22],
  ['Kleinian 群', 26],
  ['噪声', 16],
  ['体积云', 30],
  ['3D 隧道', 18],
  ['正多面体', 24],
] as const;

const leftA = [...FX_NAMES.slice(0, 11), ...GEN_NAMES.slice(0, 3)];
const leftB = [...GEN_NAMES.slice(3), ...FX_NAMES.slice(11, 18)];
const rightA = [...FX_NAMES.slice(5, 16), ...GEN_NAMES.slice(4, 8)];
const rightB = [...GEN_NAMES.slice(8), ...FX_NAMES.slice(0, 8)];

/* 数字雨：每侧五列，列距、字号、速度都故意不齐 —— 三等分一眼就看出是格子 */
const RAIN = [
  { left: '0%', dur: '23s', delay: '-5s', scale: 1, op: 1, items: leftA },
  { left: '13%', dur: '37s', delay: '-24s', scale: 0.78, op: 0.82, items: leftB },
  { left: '31%', dur: '61s', delay: '-11s', scale: 0.56, op: 0.6, items: rightB },
  { left: '49%', dur: '29s', delay: '-31s', scale: 0.88, op: 0.9, items: GEN_NAMES.slice(2, 14) },
  { left: '76%', dur: '79s', delay: '-17s', scale: 0.46, op: 0.5, items: FX_NAMES.slice(4, 16) },
];

const RAIN_R = [
  { left: '0%', dur: '31s', delay: '-9s', scale: 0.94, op: 0.95, items: rightA },
  { left: '17%', dur: '53s', delay: '-38s', scale: 0.62, op: 0.66, items: rightB },
  { left: '34%', dur: '41s', delay: '-14s', scale: 0.8, op: 0.84, items: GEN_NAMES.slice(6, 16) },
  { left: '57%', dur: '67s', delay: '-2s', scale: 0.5, op: 0.52, items: FX_NAMES.slice(9, 20) },
  { left: '83%', dur: '27s', delay: '-22s', scale: 0.9, op: 0.9, items: leftA.slice(3) },
];

const stat = (n: number) => `${n}+`;
---

<section class="fx" aria-labelledby="effects-title">
  <div class="fx-stack" aria-hidden="true">
    {
      stack.map((card) => (
        <img
          class="fx-card"
          src={card.src}
          alt=""
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          data-deg={card.deg}
          style={`--x:${card.x};--y:${card.y};--ry:${card.deg}deg;--rx:${card.rx};z-index:${card.z}`}
        />
      ))
    }
  </div>
  <div class="fx-veil" aria-hidden="true"></div>
  <div class="fx-plate" aria-hidden="true"></div>

  {
    [
      { side: 'l', cols: RAIN },
      { side: 'r', cols: RAIN_R },
    ].map((rail) => (
      <div class:list={['fx-rail', `fx-rail--${rail.side}`]} aria-hidden="true">
        {rail.cols.map((col) => (
          <div
            class="fx-rail-col"
            style={`--left:${col.left};--dur:${col.dur};--delay:${col.delay};--scale:${col.scale};--op:${col.op}`}
          >
            {[0, 1].map(() => (
              <div class="fx-rail-seq">
                {col.items.map(([name, size], i) => (
                  <span class:list={['fx-name', i % 3 === 1 && 'fx-name--line']} style={`--sz:${size}px`}>
                    {name}
                  </span>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>
    ))
  }

  <div class="fx-main">
    <h2 class="fx-eyebrow" id="effects-title"><Tri />旗舰级开源特效库<Tri dir="left" /></h2>
    <p class="fx-sub">持续更新，保持审美前沿。</p>

    <div class="fx-stats">
      <span class="fx-stat"><em>{stat(stats.effects)}</em> 特效</span>
      <span class="fx-stat"><em>{stat(stats.generators)}</em> 生成器</span>
      <span class="fx-stat"><em>{stat(stats.transitions)}</em> 转场</span>
    </div>

    <p class="fx-note">所见即所得，由时间作为种子，导出的每一帧都与实时预览丝毫不差。</p>
  </div>
</section>

<script>
  /**
   * 卡扇自转。离开视窗就停 —— 24 张图每帧只写 transform，但没必要在看不见时也写。
   * 减弱动效时保持静态构图。
   */
  const stage = document.querySelector<HTMLElement>('.fx-stack');
  const cards = stage ? [...stage.querySelectorAll<HTMLElement>('.fx-card')] : [];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && cards.length && !reduced) {
    let visible = false;
    let running = false;
    let raf = 0;
    const start = performance.now();

    const loop = (now: number) => {
      if (!running) return;
      const spin = ((now - start) / 1000) * 2.6;
      for (const el of cards) {
        const base = Number(el.dataset.deg) || 0;
        const deg = base + spin;
        const a = (deg * Math.PI) / 180;
        el.style.transform = `translate(-50%, -50%) translate(${(Math.cos(a) * 36).toFixed(2)}vw, ${(Math.sin(a) * 30).toFixed(2)}vh) rotateY(${deg.toFixed(1)}deg) rotateX(${(Math.sin(a) * 10 - 4).toFixed(1)}deg)`;
      }
      raf = requestAnimationFrame(loop);
    };

    const play = () => {
      if (!visible || document.hidden || running) return;
      running = true;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? play() : stop();
    }, { rootMargin: '120px' }).observe(stage);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : play();
    });
  }
</script>

<style>
  .fx-card {
    will-change: transform;
  }
</style>
