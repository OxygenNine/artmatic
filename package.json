{
  "name": "artmatic",
  "version": "0.3.1",
  "description": "面向算法艺术与故障艺术的 Web 原生剪辑软件",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "homepage": "https://github.com/OxygenNine/artmatic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxygenNine/artmatic.git"
  },
  "bugs": {
    "url": "https://github.com/OxygenNine/artmatic/issues"
  },
  "keywords": [
    "video-editor",
    "glitch-art",
    "generative-art",
    "algorithmic-art",
    "webgl2",
    "webcodecs"
  ],
  "bin": {
    "artmatic": "./bin/artmatic.mjs"
  },
  "files": [
    "dist",
    "bin",
    "server/*.mjs",
    "server/*.json",
    "scripts/capacity.mjs",
    "scripts/llm-proxy.mjs",
    "LICENSE",
    "CREDITS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-llm-routes.mjs && vite build && node scripts/check-bundle.mjs",
    "gen:llm-routes": "node scripts/gen-llm-routes.mjs",
    "preview": "vite preview",
    "serve": "node bin/artmatic.mjs",
    "prepack": "pnpm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:mutate": "stryker run",
    "test:e2e": "node scripts/e2e.mjs",
    "mcp": "node mcp/index.mjs",
    "cli": "node scripts/cli.mjs",
    "capacity": "node scripts/capacity.mjs",
    "fonts:sfnt": "node scripts/fonts-woff2-to-sfnt.mjs",
    "desktop": "install-electron && electron desktop/main.mjs",
    "desktop:probe": "install-electron && electron desktop/main.mjs --probe",
    "desktop:artifact": "pnpm run build && install-electron && node desktop/build.mjs",
    "desktop:smoke": "install-electron && node desktop/smoke.mjs",
    "site:dev": "pnpm -C site run dev",
    "site:build": "pnpm -C site run build"
  },
  "devDependencies": {
    "@lucide/svelte": "1.49.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.6.5",
    "@zumer/snapdom": "3.4.0",
    "acorn": "8.18.0",
    "electron": "44.9.3",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "gl-transitions": "1.71.0",
    "harfbuzzjs": "1.6.4",
    "marked": "18.1.1",
    "mediabunny": "1.62.1",
    "pinyin-pro": "3.29.5",
    "polygon-clipping": "0.15.7",
    "resedit": "^3.1.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wawoff2": "2.0.1"
  }
}
